<UserControl x:Class="DicomViewer.WpfApp.Views.ViewerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DicomViewer.UI.Controls;assembly=DicomViewer.UI" xmlns:converters="clr-namespace:DicomViewer.UI.Converters;assembly=DicomViewer.UI" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:enums="clr-namespace:DicomViewer.Domain.Enums;assembly=DicomViewer.Domain" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:viewmodels="clr-namespace:DicomViewer.ViewModels;assembly=DicomViewer.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ViewerViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ToolEnumConverter x:Key="ToolEnumConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!--  값이 없으면(null) 접히는 InfoBar 스타일 / InfoBar style that collapses when the bound message is null  -->
        <Style x:Key="BannerInfoBarStyle"
               BasedOn="{StaticResource {x:Type ui:InfoBar}}"
               TargetType="ui:InfoBar">
            <Setter Property="IsOpen" Value="True" />
            <Setter Property="IsClosable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Message, RelativeSource={RelativeSource Self}}"
                             Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  ===== 왼쪽: 데이터셋·시리즈 / Left: dataset and series =====  -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,16,16,12">
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Text="{Binding DatasetId}"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="DatasetId" />
                        <TextBlock Margin="0,6,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Classification}"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="DatasetClassification" />
                        <TextBlock Margin="0,6,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding Attribution}"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="DatasetAttribution" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Margin="16,4,16,8" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="SERIES" />

                    <ListBox Grid.Row="2" Margin="8,0,8,8"
                             ItemsSource="{Binding SeriesList}"
                             SelectedItem="{Binding SelectedSeries}"
                             AutomationProperties.AutomationId="SeriesList" AutomationProperties.Name="Series">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Padding="6,3" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4">
                                        <TextBlock FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                   Text="{Binding Modality}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontSize="12"
                                                   Text="{Binding SeriesDescription, TargetNullValue='Series'}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="{Binding NumberOfInstances, Mode=OneWay}" />
                                            <Run Text="images" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  표시 영상 위에 그린 측정값 목록 (그리기 레이어는 UI 자동화에 보이지 않으므로 목록으로도 노출한다)  -->
                    <!--  Measurements drawn on the displayed image, also listed as text because the drawn overlay is invisible to UI Automation  -->
                    <StackPanel Grid.Row="3" Margin="16,4,16,12">
                        <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="MEASUREMENTS" />
                        <ListBox MaxHeight="96"
                                 ItemsSource="{Binding Measurements}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="MeasurementList" AutomationProperties.Name="Measurements">
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource {x:Type ListBoxItem}}"
                                       TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="MeasurementItem" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12"
                                               Text="{Binding Label}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ===== 중앙: 안내 배너 + 뷰어 + 슬라이더 / Center: banners, viewer and slider =====  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="12,12,12,4">
                    <ui:InfoBar Title="Slice order"
                                Message="{Binding GeometryBanner}"
                                Severity="Warning"
                                Style="{StaticResource BannerInfoBarStyle}"
                                AutomationProperties.AutomationId="GeometryBanner" />
                    <ui:InfoBar Title="Pixel spacing"
                                Message="{Binding SpacingBanner}"
                                Severity="Warning"
                                Style="{StaticResource BannerInfoBarStyle}"
                                AutomationProperties.AutomationId="SpacingBanner" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="12,0">
                    <controls:DicomImageViewer CurrentSlice="{Binding CurrentSliceIndex, Mode=TwoWay}"
                                               CurrentTool="{Binding CurrentTool}"
                                               FlipHorizontal="{Binding FlipHorizontal, Mode=TwoWay}"
                                               FlipVertical="{Binding FlipVertical, Mode=TwoWay}"
                                               Frame="{Binding Frame}"
                                               Measurements="{Binding Measurements}"
                                               PanX="{Binding PanX, Mode=TwoWay}"
                                               PanY="{Binding PanY, Mode=TwoWay}"
                                               RotationAngle="{Binding RotationAngle, Mode=TwoWay}"
                                               TotalSlices="{Binding TotalSliceCount}"
                                               WindowCenter="{Binding WindowCenter, Mode=TwoWay}"
                                               WindowWidth="{Binding WindowWidth, Mode=TwoWay}"
                                               ZoomFactor="{Binding ZoomFactor, Mode=TwoWay}"
                                               AddMeasurementCommand="{Binding AddMeasurementCommand}"
                                               AutomationProperties.AutomationId="ViewerSurface" AutomationProperties.Name="DICOM image" />

                    <controls:LoadingIndicator HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsActive="{Binding IsLoading}"
                                               ShowText="True" SpinnerSize="48" Text="Loading..." AutomationProperties.AutomationId="LoadingIndicator" />

                    <!--  영상이 없거나 오류일 때의 안내와 다시 시도 / Guidance and retry when there is no image or an error occurred  -->
                    <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="StatePanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="Empty">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}"
                                                 Value="Error">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock HorizontalAlignment="Center"
                                   Text="{Binding StatusText}"
                                   TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="StateMessage" />
                        <ui:Button Margin="0,12,0,0" HorizontalAlignment="Center" Appearance="Primary"
                                   Command="{Binding OpenDatasetCommand}"
                                   Content="Retry" AutomationProperties.AutomationId="RetryButton">
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource {x:Type ui:Button}}"
                                       TargetType="ui:Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}"
                                                     Value="Error">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>

                    <!--  표시되는(윈도우 적용된) 8비트 영상의 히스토그램 / Histogram of the displayed (windowed) 8-bit image  -->
                    <controls:HistogramViewer Width="200" Height="120" Margin="16,16,16,56" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                              HistogramData="{Binding Frame.Histogram}"
                                              ShowWindowLevelOverlay="False"
                                              Visibility="{Binding ShowHistogram, Converter={StaticResource BoolToVisConverter}}"
                                              AutomationProperties.AutomationId="Histogram" AutomationProperties.Name="Image histogram" />
                </Grid>

                <!--  슬라이스 슬라이더 / Slice slider  -->
                <Border Grid.Row="2" Margin="12,8,12,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid Margin="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" MinWidth="40" Padding="8,4"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="4">
                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                       Text="{Binding SliceDisplayNumber}"
                                       AutomationProperties.AutomationId="SliceNumber" />
                        </Border>

                        <controls:ModernSlider Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                                               Maximum="{Binding MaxSliceIndex}"
                                               Minimum="0" AutomationProperties.AutomationId="SliceSlider" AutomationProperties.Name="Slice"
                                               Value="{Binding CurrentSliceIndex}" />

                        <Border Grid.Column="2" MinWidth="40" Padding="8,4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="4">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding TotalSliceCount}"
                                       AutomationProperties.AutomationId="SliceTotal" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!--  ===== 오른쪽: 도구 패널 / Right: tools panel =====  -->
            <Border Grid.Column="2" Width="80"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,8">
                        <TextBlock Margin="0,0,0,4" HorizontalAlignment="Center" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="TOOLS" />

                        <controls:IconToggleButton Margin="0,1"
                                                   Command="{Binding SelectToolCommand}"
                                                   CommandParameter="{x:Static enums:ViewerTool.Pan}"
                                                   Icon="&#xE8B0;" IconSize="18"
                                                   IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={StaticResource ToolEnumConverter}, ConverterParameter=Pan}"
                                                   ToolTip="Pan - drag to move the image" AutomationProperties.AutomationId="ToolPan" AutomationProperties.Name="Pan" />
                        <controls:IconToggleButton Margin="0,1"
                                                   Command="{Binding SelectToolCommand}"
                                                   CommandParameter="{x:Static enums:ViewerTool.Zoom}"
                                                   Icon="&#xE71E;" IconSize="18"
                                                   IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={StaticResource ToolEnumConverter}, ConverterParameter=Zoom}"
                                                   ToolTip="Zoom - drag up or down" AutomationProperties.AutomationId="ToolZoom" AutomationProperties.Name="Zoom" />
                        <controls:IconToggleButton Margin="0,1"
                                                   Command="{Binding SelectToolCommand}"
                                                   CommandParameter="{x:Static enums:ViewerTool.WindowLevel}"
                                                   Icon="&#xE793;" IconSize="18"
                                                   IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={StaticResource ToolEnumConverter}, ConverterParameter=WindowLevel}"
                                                   ToolTip="Window/Level - drag to adjust brightness and contrast" AutomationProperties.AutomationId="ToolWindowLevel" AutomationProperties.Name="Window and level" />
                        <controls:IconToggleButton Margin="0,1"
                                                   Command="{Binding SelectToolCommand}"
                                                   CommandParameter="{x:Static enums:ViewerTool.Measure}"
                                                   Icon="&#xECC6;" IconSize="18"
                                                   IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={StaticResource ToolEnumConverter}, ConverterParameter=Measure}"
                                                   ToolTip="Measure - drag on the image (mm when the pixel spacing is known, otherwise px)" AutomationProperties.AutomationId="ToolMeasure" AutomationProperties.Name="Measure" />

                        <controls:IconButton Margin="0,1"
                                             Command="{Binding ClearMeasurementsCommand}"
                                             Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                             Icon="&#xE74D;" IconSize="14" ToolTip="Clear measurements" AutomationProperties.AutomationId="ClearMeasurements" AutomationProperties.Name="Clear measurements" />

                        <Separator Margin="2,6" />

                        <UniformGrid Margin="0,2" Columns="2" Rows="2">
                            <controls:IconButton Margin="1"
                                                 Command="{Binding RotateLeftCommand}"
                                                 Icon="&#xE80C;" IconSize="14" ToolTip="Rotate left 90°" AutomationProperties.AutomationId="RotateLeft" AutomationProperties.Name="Rotate left" />
                            <controls:IconButton Margin="1"
                                                 Command="{Binding RotateRightCommand}"
                                                 Icon="&#xE80D;" IconSize="14" ToolTip="Rotate right 90°" AutomationProperties.AutomationId="RotateRight" AutomationProperties.Name="Rotate right" />
                            <controls:IconButton Margin="1"
                                                 Command="{Binding ToggleFlipHorizontalCommand}"
                                                 Icon="&#xE8B7;" IconSize="14" ToolTip="Flip horizontal" AutomationProperties.AutomationId="FlipHorizontal" AutomationProperties.Name="Flip horizontal" />
                            <controls:IconButton Margin="1"
                                                 Command="{Binding ToggleFlipVerticalCommand}"
                                                 Icon="&#xE700;" IconSize="14" ToolTip="Flip vertical" AutomationProperties.AutomationId="FlipVertical" AutomationProperties.Name="Flip vertical" />
                        </UniformGrid>

                        <Separator Margin="2,6" />

                        <controls:IconButton Margin="0,1"
                                             Command="{Binding ResetViewCommand}"
                                             Icon="&#xE72C;" IconSize="16" ToolTip="Reset zoom, pan, rotation and flips" AutomationProperties.AutomationId="ResetView" AutomationProperties.Name="Reset view" />

                        <UniformGrid Margin="0,2" Columns="2">
                            <controls:IconButton Margin="1"
                                                 Command="{Binding ZoomInCommand}"
                                                 Icon="&#xE8A3;" IconSize="14" ToolTip="Zoom in" AutomationProperties.AutomationId="ZoomIn" AutomationProperties.Name="Zoom in" />
                            <controls:IconButton Margin="1"
                                                 Command="{Binding ZoomOutCommand}"
                                                 Icon="&#xE71F;" IconSize="14" ToolTip="Zoom out" AutomationProperties.AutomationId="ZoomOut" AutomationProperties.Name="Zoom out" />
                        </UniformGrid>

                        <controls:IconToggleButton Margin="0,1" Icon="&#xE9D9;" IconSize="16"
                                                   IsChecked="{Binding ShowHistogram}"
                                                   ToolTip="Show or hide the histogram of the displayed 8-bit image" AutomationProperties.AutomationId="ToggleHistogram" AutomationProperties.Name="Histogram" />

                        <Separator Margin="2,6" />

                        <TextBlock Margin="0,0,0,4" HorizontalAlignment="Center" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="W/L" />

                        <controls:IconButton Margin="0,1"
                                             Command="{Binding ResetWindowLevelCommand}"
                                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                             Icon="&#xE777;" IconSize="14" ToolTip="Restore the DICOM default Window/Level" AutomationProperties.AutomationId="ResetWindowLevel" AutomationProperties.Name="Default window and level" />

                        <UniformGrid Margin="0,2" Columns="2" Rows="2">
                            <controls:IconButton Margin="1"
                                                 Command="{Binding ApplyWindowLevelPresetCommand}"
                                                 CommandParameter="Abdomen" Icon="&#xEBD2;" IconSize="12" ToolTip="Abdomen: W 400 / L 40" AutomationProperties.AutomationId="PresetAbdomen" AutomationProperties.Name="Abdomen preset" />
                            <controls:IconButton Margin="1"
                                                 Command="{Binding ApplyWindowLevelPresetCommand}"
                                                 CommandParameter="Lung" Icon="&#xE95E;" IconSize="12" ToolTip="Lung: W 1500 / L -600" AutomationProperties.AutomationId="PresetLung" AutomationProperties.Name="Lung preset" />
                            <controls:IconButton Margin="1"
                                                 Command="{Binding ApplyWindowLevelPresetCommand}"
                                                 CommandParameter="Bone" Icon="&#xE9D9;" IconSize="12" ToolTip="Bone: W 2000 / L 500" AutomationProperties.AutomationId="PresetBone" AutomationProperties.Name="Bone preset" />
                            <controls:IconButton Margin="1"
                                                 Command="{Binding ApplyWindowLevelPresetCommand}"
                                                 CommandParameter="Brain" Icon="&#xE94E;" IconSize="12" ToolTip="Brain: W 80 / L 40" AutomationProperties.AutomationId="PresetBrain" AutomationProperties.Name="Brain preset" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  ===== 하단 상태 표시줄 / Bottom status bar =====  -->
        <Border Grid.Row="1" Padding="12,6"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="StatusText" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="16,0,0,0" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Style>
                    </StackPanel.Resources>

                    <!--  현재 윈도우/레벨·줌·회전·반전·이동 값을 텍스트로 표시한다 (그리기 레이어가 아니라 UI 자동화로도 읽힌다)  -->
                    <!--  Current window/level, zoom, rotation, flip and pan as text, readable through UI Automation  -->
                    <TextBlock AutomationProperties.AutomationId="WindowLevelReadout">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="W {0:0.##} / L {1:0.##}">
                                <Binding Path="WindowWidth" />
                                <Binding Path="WindowCenter" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding ZoomFactor, StringFormat='Zoom {0:P0}'}"
                               AutomationProperties.AutomationId="ZoomReadout" />
                    <TextBlock Text="{Binding RotationAngle, StringFormat='Rotation {0:0.##}&#176;'}"
                               AutomationProperties.AutomationId="RotationReadout" />
                    <TextBlock AutomationProperties.AutomationId="FlipReadout">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Flip H: {0} V: {1}">
                                <Binding Path="FlipHorizontal" />
                                <Binding Path="FlipVertical" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock AutomationProperties.AutomationId="PanReadout">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Pan {0:0}, {1:0}">
                                <Binding Path="PanX" />
                                <Binding Path="PanY" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock AutomationProperties.AutomationId="MeasurementUnit">
                        <Run Text="Unit:" />
                        <Run Text="{Binding MeasurementUnit, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
