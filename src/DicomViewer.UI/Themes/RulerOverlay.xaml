<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DicomViewer.UI.Controls">

    <!--  RulerOverlay: FrameworkElement 기반으로 OnRender에서 직접 렌더링  -->
    <!--  RulerOverlay: FrameworkElement-based, renders directly in OnRender  -->
    <!--  입력 수신 여부(IsHitTestVisible)는 IsMeasuring이 결정하므로 스타일에서 지정하지 않는다  -->
    <!--  Input reception (IsHitTestVisible) is driven by IsMeasuring, so the style does not set it  -->
    <Style TargetType="{x:Type controls:RulerOverlay}">
        <Setter Property="Cursor" Value="Cross" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="LineBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
        <Setter Property="HandleBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
        <Setter Property="HandleOutlineBrush" Value="{DynamicResource ControlSolidFillColorDefaultBrush}" />
        <Setter Property="LabelBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

</ResourceDictionary>
