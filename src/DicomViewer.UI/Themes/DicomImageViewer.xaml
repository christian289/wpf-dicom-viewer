<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" xmlns:controls="clr-namespace:DicomViewer.UI.Controls" xmlns:converters="clr-namespace:DicomViewer.UI.Converters" mc:Ignorable="po">

    <!--  Converters  -->
    <converters:IndexToDisplayConverter x:Key="IndexToDisplayConverter" />

    <!--  영상 영역은 테마와 무관하게 거의 검정 유지 (의료 영상 판독용)  -->
    <!--  The image area stays near-black regardless of theme (medical viewing)  -->
    <SolidColorBrush x:Key="DicomViewerImageAreaBrush" po:Freeze="True" Color="#101010" />

    <!--  오버레이 칩: 어떤 영상 위에서도 읽을 수 있도록 반투명 어두운 배경 + 흰 글자  -->
    <!--  Overlay chips: semi-transparent dark chip with white text for legibility over any image  -->
    <SolidColorBrush x:Key="DicomViewerOverlayBackgroundBrush" po:Freeze="True" Color="#99000000" />
    <SolidColorBrush x:Key="DicomViewerOverlayTextBrush" po:Freeze="True" Color="#FFFFFF" />

    <Style TargetType="{x:Type controls:DicomImageViewer}">
        <Setter Property="Background" Value="{StaticResource DicomViewerImageAreaBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="DICOM image viewer" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DicomImageViewer}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <!--  이미지, 오버레이, 마우스 히트 테스트가 모두 이 콘텐츠 영역을 같은 뷰포트로 공유한다  -->
                        <!--  Image drawing, overlay drawing and mouse hit-testing all share this content area as the same viewport  -->
                        <Grid x:Name="PART_Content" ClipToBounds="True">
                            <!--  레이아웃 클립이 변환된 이미지를 자르지 않도록 Canvas에 배치  -->
                            <!--  Hosted in a Canvas so layout clipping never cuts the transformed image  -->
                            <Canvas IsHitTestVisible="False">
                                <!--  DICOM 이미지: 크기는 코드에서 프레임 픽셀 크기로 지정하고 변환은 MatrixTransform이 담당  -->
                                <!--  DICOM image: sized in code to the frame pixel size; a MatrixTransform carries the transform  -->
                                <Image x:Name="PART_Image" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0,0" SnapsToDevicePixels="False" Stretch="Fill" UseLayoutRounding="False" />
                            </Canvas>

                            <!--  측정 오버레이 (영상 픽셀 좌표 기반) / Measurement overlay (image pixel coordinates)  -->
                            <controls:RulerOverlay x:Name="PART_Ruler"
                                                   AddMeasurementCommand="{TemplateBinding AddMeasurementCommand}"
                                                   FlipHorizontal="{TemplateBinding FlipHorizontal}"
                                                   FlipVertical="{TemplateBinding FlipVertical}"
                                                   FrameSourceId="{TemplateBinding FrameSourceId}"
                                                   ImageHeightPx="{TemplateBinding ImagePixelHeight}"
                                                   ImageWidthPx="{TemplateBinding ImagePixelWidth}"
                                                   IsMeasuring="{TemplateBinding IsMeasuring}"
                                                   Measurements="{TemplateBinding Measurements}"
                                                   PanX="{TemplateBinding PanX}"
                                                   PanY="{TemplateBinding PanY}"
                                                   RotationAngle="{TemplateBinding RotationAngle}"
                                                   ZoomFactor="{TemplateBinding ZoomFactor}" />

                            <!--  좌하단 오버레이: W/L 정보 / Bottom-left overlay: W/L info  -->
                            <Border Margin="10" Padding="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Background="{StaticResource DicomViewerOverlayBackgroundBrush}"
                                    CornerRadius="4" IsHitTestVisible="False">
                                <StackPanel>
                                    <TextBlock FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource DicomViewerOverlayTextBrush}">
                                        <Run Text="W:" />
                                        <Run Text="{Binding WindowWidth, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat=F0}" />
                                        <Run Text="L:" />
                                        <Run Text="{Binding WindowCenter, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat=F0}" />
                                    </TextBlock>
                                    <TextBlock FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource DicomViewerOverlayTextBrush}">
                                        <Run Text="Zoom:" />
                                        <Run Text="{Binding ZoomFactor, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat=P0}" />
                                    </TextBlock>
                                    <TextBlock FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource DicomViewerOverlayTextBrush}"
                                               Opacity="0.7">
                                        <Run Text="Copy:" />
                                        <Run Text="{Binding FrameCopyMilliseconds, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat=F2}" />
                                        <Run Text="ms" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!--  우하단 오버레이: 슬라이스 정보 (1-based 표시) / Bottom-right overlay: Slice info (1-based display)  -->
                            <Border Margin="10" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="{StaticResource DicomViewerOverlayBackgroundBrush}"
                                    CornerRadius="4" IsHitTestVisible="False">
                                <TextBlock FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource DicomViewerOverlayTextBrush}">
                                    <Run Text="Slice:" />
                                    <Run Text="{Binding CurrentSlice, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={StaticResource IndexToDisplayConverter}}" />
                                    <Run Text="/" />
                                    <Run Text="{Binding TotalSlices, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
